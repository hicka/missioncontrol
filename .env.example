# Copy to .env (chmod 600). .env is gitignored.
# MiniMax API key: the team runs on MiniMax-M3 via the Anthropic-compatible route
MINIMAX_API_KEY=
# BlueBubbles server password (Server > Settings in the BlueBubbles app)
BLUEBUBBLES_PASSWORD=
# Optional: Envoyer API token if your devops agent deploys with bin/envoyer
ENVOYER_API_KEY=
# Optional: Meta Graph API for bin/meta (Facebook Page + linked Instagram posts).
# Use a system user token from Meta Business Suite with pages_manage_posts,
# pages_read_engagement, pages_show_list, instagram_basic and
# instagram_content_publish. META_IG_USER_ID is found from the Page if blank.
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
# Optional: TypeSafe (Jev) decision model. Gates the reflection pass so a
# short turn that taught the team something is no longer dropped unread.
# Without it the old floor-and-cooldown heuristic stands.
TYPESAFE_API_KEY=
